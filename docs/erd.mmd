%%{init: {'theme': 'base', 'themeVariables': {'fontSize': '13px'}}}%%
erDiagram
    USERS {
        bigint id PK
        string username UK
        string email UK
        string role "mahasiswa|dosen|client|admin"
        string location
        string city
        string ig
        string avatar
        string cover_image
        timestamp created_at
    }

    CATEGORIES {
        bigint id PK
        string name
        string slug UK
    }

    ARTWORKS {
        bigint id PK
        bigint user_id FK
        bigint category_id FK
        string title
        string image_path
        int share_count
        string license "HKI"
        boolean originality_confirmed
        string status "pending|approved|rejected"
        text moderation_note
        bigint moderated_by FK
        timestamp created_at
    }

    ARTWORK_LIKES {
        bigint id PK
        bigint user_id FK "UK(user,artwork)"
        bigint artwork_id FK "UK(user,artwork)"
        timestamp created_at
    }

    ARTWORK_SAVES {
        bigint id PK
        bigint user_id FK "UK(user,artwork)"
        bigint artwork_id FK "UK(user,artwork)"
        timestamp created_at
    }

    ARTWORK_REPORTS {
        bigint id PK
        bigint artwork_id FK
        bigint reporter_id FK
        string reason
        string status "open|reviewed|resolved|dismissed"
        bigint reviewed_by FK
        timestamp created_at
    }

    ARTICLES {
        bigint id PK
        bigint user_id FK
        bigint category_id FK
        string title
        string status "pending|approved|rejected"
        text moderation_note
        bigint moderated_by FK
        timestamp created_at
    }

    FOLLOWS {
        bigint id PK
        bigint follower_id FK "UK"
        bigint followed_id FK "UK"
        timestamp created_at
    }

    USERS ||--o{ ARTWORKS : uploads
    CATEGORIES ||--o{ ARTWORKS : groups
    USERS ||--o{ ARTWORK_LIKES : likes
    ARTWORKS ||--o{ ARTWORK_LIKES : liked_by
    USERS ||--o{ ARTWORK_SAVES : saves
    ARTWORKS ||--o{ ARTWORK_SAVES : saved_by
    USERS ||--o{ ARTWORK_REPORTS : reports
    ARTWORKS ||--o{ ARTWORK_REPORTS : reported
    USERS ||--o{ ARTICLES : authors
    CATEGORIES ||--o{ ARTICLES : groups
    USERS ||--o{ FOLLOWS : follows
